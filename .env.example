POSTGRES_PASSWORD=change-me
# Password of the restricted runtime role the API connects as (created on first volume initialization)
APP_DB_PASSWORD=change-me-too
# Sign-in (Microsoft Entra External ID app registration). Redirect URI: <public origin>/signin-oidc
OIDC_AUTHORITY=https://<tenant-subdomain>.ciamlogin.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Chat model that writes answers (Ask feature) and optional switches/limits
OPENAI_CHAT_MODEL=gpt-5.6-luna
# RAG_ENABLED=true
# RAG_RATE_LIMIT_PERMITS=20
# RAG_RATE_LIMIT_WINDOW_SECONDS=60
# RAG_MAX_CONCURRENT_STREAMS=2
# Document storage: LocalDisk (documents volume) or AzureBlob (then set the account/container; use either a
# connection string or a managed identity with the Storage Blob Data Contributor role)
# STORAGE_PROVIDER=LocalDisk
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_CONTAINER=documents
# AZURE_STORAGE_CONNECTION_STRING=
# Minimum cosine similarity (0-1) for a search result; 0 disables the filter
SEARCH_MIN_SIMILARITY=0.25
# The UI (nginx) is the only published port; it proxies the API on the same origin.
# UI_PORT=8080
