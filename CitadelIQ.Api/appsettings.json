{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "OpenAI": {
    "EmbeddingModel": "text-embedding-3-small"
  },
  "Upload": {
    "MaxFileSizeMB": 20,
    "AllowedExtensions": [".pdf", ".docx", ".txt", ".csv", ".xlsx"]
  },
  "Chunking": {
    "ChunkSize": 800,
    "ChunkOverlap": 150
  },
  "Search": {
    "DefaultTopK": 10
  }
}
