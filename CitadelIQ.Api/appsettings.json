{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "CitadelIQ": "",
    "CitadelIQMigrations": ""
  },
  "Authentication": {
    "Mode": "Oidc",
    "Oidc": {
      "Authority": "",
      "ClientId": "",
      "Scopes": ["openid", "profile", "email"]
    },
    "Session": {
      "CookieName": "__Host-citadeliq",
      "IdleTimeoutHours": 8,
      "AbsoluteLifetimeDays": 7
    },
    "JoinRateLimit": {
      "PermitLimit": 10,
      "WindowMinutes": 60
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "OpenAI": {
    "ApiKey": "",
    "EmbeddingModel": "",
    "EmbeddingDimension": 1536,
    "ChatModel": "gpt-5.6-luna"
  },
  "Rag": {
    "Enabled": true,
    "MaxContextChunks": 8,
    "MaxContextChunksCap": 12,
    "MaxContextChars": 8000,
    "MinSimilarity": 0.30,
    "MaxQuestionLength": 1000,
    "MaxHistoryTurns": 10,
    "MaxHistoryChars": 12000,
    "RewriteAnswerExcerptChars": 500,
    "RateLimit": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "MaxConcurrentStreams": 2
    }
  },
  "Upload": {
    "MaxFileSizeMB": 20,
    "AllowedExtensions": [".pdf", ".docx", ".txt", ".csv", ".xlsx"]
  },
  "Chunking": {
    "ChunkSize": 400,
    "ChunkOverlap": 80
  },
  "Search": {
    "DefaultTopK": 10,
    "MaxTopK": 50,
    "MinSimilarity": 0.25
  },
  "Storage": {
    "Provider": "LocalDisk",
    "DocumentsPath": "App_Data/documents",
    "AzureBlob": {
      "AccountName": "",
      "ContainerName": "documents",
      "CreateContainerIfMissing": false
    }
  }
}
