{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "CitadelIQ": "",
    "CitadelIQMigrations": ""
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Authentication": {
    "Mode": "Oidc",
    "Oidc": {
      "Authority": "",
      "ClientId": "",
      "Scopes": ["openid", "profile", "email"]
    },
    "Session": {
      "CookieName": "__Host-citadeliq",
      "IdleTimeoutHours": 8,
      "AbsoluteLifetimeDays": 7
    },
    "JoinRateLimit": {
      "PermitLimit": 10,
      "WindowMinutes": 60
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "OpenAI": {
    "ApiKey": "",
    "EmbeddingModel": "",
    "EmbeddingDimension": 1536,
    "ChatModel": "gpt-5.6-luna"
  },
  "Rag": {
    "Enabled": true,
    "MaxContextChunks": 8,
    "MaxContextChunksCap": 12,
    "MaxContextChars": 8000,
    "MinSimilarity": 0.30,
    "MaxQuestionLength": 1000,
    "MaxHistoryTurns": 10,
    "MaxHistoryChars": 12000,
    "RewriteAnswerExcerptChars": 500,
    "RateLimit": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "MaxConcurrentStreams": 2
    }
  },
  "Upload": {
    "MaxFileSizeMB": 20,
    "AllowedExtensions": [".pdf", ".docx", ".txt", ".csv", ".xlsx"]
  },
  "Chunking": {
    "ChunkSize": 400,
    "ChunkOverlap": 80
  },
  "Search": {
    "DefaultTopK": 10,
    "MaxTopK": 50,
    "MinSimilarity": 0.25
  },
  "EmailAgent": {
    "Mode": "Off",
    "SupportAddress": "",
    "SupportDisplayName": "CitadelIQ",
    "PortalBaseUrl": "",
    "AllowDevelopmentIdentities": false,
    "ConfidenceThreshold": 0.8,
    "MinCitedSimilarity": 0.45,
    "MaxSearchAttempts": 2,
    "MaxBodyChars": 6000,
    "MaxAutomaticRepliesPerThread": 5,
    "MaxDraftChars": 10000,
    "Limits": {
      "PerUserPerHour": 10,
      "PerOrganizationPerDay": 200,
      "TotalPerDay": 2000,
      "MaxSentPerDay": 1500
    },
    "MaxAttempts": 3,
    "RetryDelaysSeconds": [60, 300, 900],
    "ProcessingLeaseMinutes": 10,
    "PollIntervalSeconds": 120,
    "IdleRefreshMinutes": 9,
    "NotificationIntervalMinutes": 15,
    "DraftExpiryDays": 30,
    "ActivityRetentionDays": 90,
    "MaintenanceIntervalMinutes": 60,
    "HealthFailureMinutes": 10,
    "Mailbox": {
      "Host": "",
      "ImapPort": 993,
      "SmtpHost": "",
      "SmtpPort": 587,
      "Username": "",
      "AuthMode": "Password",
      "InboxFolder": "INBOX",
      "ArchiveFolder": "CitadelIQ/Processed",
      "SentFolder": "[Gmail]/Sent Mail",
      "AppendToSent": false,
      "TrustedAuthServId": ""
    }
  },
  "Storage": {
    "Provider": "LocalDisk",
    "DocumentsPath": "App_Data/documents",
    "AzureBlob": {
      "AccountName": "",
      "ContainerName": "documents",
      "CreateContainerIfMissing": false
    }
  }
}
